---
import TrustLayout from '../../layouts/TrustLayout.astro';
import {exportLinks} from '../../data/exportServices';
import {trustPages} from '../../data/trustContent';
import {trustMedia} from '../../data/trustMedia';
import TrustBlock from '../../components/trust/TrustBlock.astro';
import '../../styles/export-illustrated.css';

const {title, description, label, group, opening} = trustPages.overview;
const cardImages = ['buying-guide-multibrand', 'vehicle-inspection-evidence', 'shipping', 'support-branded', 'records'];
const intro = opening.body.split('\n')[0];
const steps = [
  {title: 'Send your brief', body: 'Share the models, quantity and destination so we can prepare the vehicle search.', href: '/quote/?service=export-services', action: 'Request a quote'},
  {title: 'Sourcing and inspection', body: 'We contact suppliers and arrange inspections before the cars are released.', href: '/export-services/sourcing-inspection/', action: 'How we inspect'},
  {title: 'Shipping and documents', body: 'We coordinate the route, shipping documents and vehicle handover.', href: '/export-services/shipping-support/', action: 'Shipping options'},
  {title: 'After-sales support', body: 'We pass vehicle issues and parts requests to the provider responsible for your order.', href: '/export-services/after-sales/', action: 'Support requests'},
];
---
<TrustLayout {title} {description} {label} {group} image={trustMedia(opening.image).src}
  pageType="CollectionPage" collection={exportLinks.map(link => ({name: link.label, url: link.href}))}>
  <section class="tc-wrap tc-opening overview-opening" aria-labelledby="tc-page-title">
    <h1 id="tc-page-title">{opening.title}</h1>
    <p class="overview-intro">{intro}</p>
    <a class="tc-button" href="/quote/?service=export-services">Request a quote</a>
  </section>

  <ul id="services" class="tc-wrap overview-services" aria-label="Export services and buying resources">
    {exportLinks.map((link, index) => {
      const wide = index >= 3;
      const asset = trustMedia(cardImages[index]);
      return <li class:list={{'overview-service--wide': wide}}>
        <a class="overview-card" href={link.href} aria-labelledby={`service-title-${index}`} aria-describedby={`service-summary-${index}`}>
          <img src={asset.src} srcset={asset.srcset}
            sizes={wide ? '(max-width: 679px) calc(100vw - 50px), (max-width: 1416px) 47vw, 640px' : '(max-width: 679px) calc(100vw - 50px), (max-width: 1416px) 31vw, 420px'}
            width={asset.width} height={asset.height} alt={asset.alt}
            loading={wide ? 'lazy' : 'eager'} decoding="async" data-asset-kind={asset.kind}/>
          <div class="overview-card-copy">
            <h2 id={`service-title-${index}`}>{link.label}</h2>
            <p id={`service-summary-${index}`}>{link.summary}</p>
          </div>
        </a>
      </li>;
    })}
  </ul>

  <section class="tc-wrap overview-process" aria-labelledby="overview-process-title">
    <h2 id="overview-process-title">How an export order works</h2>
    <ol class="overview-steps">
      {steps.map((step, index) => <li>
        <span class="overview-step-number">{String(index + 1).padStart(2, '0')}</span>
        <h3>{step.title}</h3>
        <p>{step.body}</p>
        <a class="tc-text-link" href={step.href}>{step.action}</a>
      </li>)}
    </ol>
  </section>

  <TrustBlock block={{id: 'overview-inquiry', title: 'Tell us about your order', body: 'Share the models, quantity and destination.', kind: 'contact', links: [{label: 'Request a quote', href: '/quote/?service=export-services'}, {label: 'Read the FAQ', href: '/export-services/faq/'}]}}/>
</TrustLayout>

<style>
  /* Centred editorial opening, as on the Autohaus reference. */
  .overview-opening { display: grid; justify-items: center; gap: 20px; text-align: center; }
  :global(body.inner-autohaus #main) .overview-opening h1 { max-width: 16ch; margin-inline: auto; text-wrap: balance; }
  :global(body.inner-autohaus #main) .overview-intro { max-width: 56ch; margin: 0 auto; color: #606060; font-size: clamp(16px, 1.3vw, 18px); line-height: 1.8; }
  :global(body.inner-autohaus #main) .overview-opening .tc-button { margin-top: 6px; }
  :global(body.inner-autohaus #main) .overview-services {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--space-grid);
    margin: 0 auto clamp(56px, 7vw, 88px);
    padding: 0;
    list-style: none;
  }
  .overview-services > li { grid-column: span 2; min-width: 0; }
  .overview-services > .overview-service--wide { grid-column: span 3; }
  /* Autohaus-style photo cards: white frame, title and summary set on a dark fade over the photograph. */
  .overview-card {
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    padding: 4px;
    border-radius: 24px;
    background: #fff;
    box-shadow: 0 0 0 1px #2121210d, 0 10px 30px #2121211a;
    color: #fff;
    text-decoration: none !important;
    transition: box-shadow 180ms ease, transform 180ms ease;
  }
  .overview-card:hover { box-shadow: 0 0 0 1px #2121210d, 0 16px 40px #21212126; transform: translateY(-2px); }
  .overview-card:focus-visible { outline: 2px solid #212121; outline-offset: 4px; }
  .overview-card img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 20px;
    transition: transform 400ms ease;
  }
  .overview-card:hover img { transform: scale(1.03); }
  .overview-service--wide .overview-card img { aspect-ratio: 16 / 9; }
  :global(body.inner-autohaus #main) .overview-card-copy {
    position: absolute;
    inset: auto 4px 4px;
    display: grid;
    gap: 6px;
    padding: 72px 24px 22px;
    border-radius: 0 0 20px 20px;
    background: linear-gradient(to top, #000000d0 0%, #00000080 55%, #0000 100%);
  }
  :global(body.inner-autohaus #main) .overview-card-copy h2 { margin: 0; color: #fff; font-size: clamp(20px, 1.8vw, 24px); line-height: 1.2; }
  :global(body.inner-autohaus #main) .overview-card-copy p { max-width: 40ch; margin: 0; color: #ffffffd9; font-size: 15px; line-height: 1.55; }

  .overview-process { margin-bottom: clamp(56px, 7vw, 88px); }
  :global(body.inner-autohaus #main) .overview-process h2 { margin: 0 auto 36px; font-size: clamp(28px, 3.4vw, 44px); line-height: 1.15; letter-spacing: -0.03em; text-align: center; }
  .overview-steps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin: 0; padding: 0; list-style: none; }
  .overview-steps li { display: flex; flex-direction: column; min-width: 0; padding: 26px 24px; border-radius: 20px; background: #f5f5f5; }
  .overview-step-number { display: grid; place-items: center; width: 34px; height: 34px; margin-bottom: 16px; border-radius: 50%; background: #f5c400; color: #212121; font-size: 13px; font-weight: 600; font-variant-numeric: tabular-nums; }
  :global(body.inner-autohaus #main) .overview-steps h3 { margin: 0; font-size: 18px; line-height: 1.35; }
  :global(body.inner-autohaus #main) .overview-steps p { margin: 8px 0 18px; color: #606060; font-size: 15px; line-height: 1.7; }
  .overview-steps .tc-text-link { margin-top: auto; }

  @media (max-width: 999px) {
    .overview-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 679px) {
    :global(body.inner-autohaus #main) .overview-services { grid-template-columns: minmax(0, 1fr); }
    .overview-services > li,
    .overview-services > .overview-service--wide { grid-column: 1; }
    .overview-card img, .overview-service--wide .overview-card img { aspect-ratio: 4 / 3; }
    .overview-steps { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 599px) {
    :global(body.inner-autohaus #main) .tc-opening.overview-opening { gap: 14px; padding-block: 24px 32px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .overview-card, .overview-card img { transition: none; }
  }
</style>
