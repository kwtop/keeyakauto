---
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import VehicleDetail from '../../../components/VehicleDetail';
import {vehicles,brandHref,vehicleHref,type Vehicle} from '../../../data/catalog';
import {detailRecommendations} from '../../../data/detailRecommendations';
import {vehicleDescription,vehicleStructuredData,vehicleTitle} from '../../../data/vehicleSeo';
import {assembleVehicleDetails} from '../../../data/vehicleDetailAssembly';
import {productModelFocus} from '../../../data/productModelFocus';
export function getStaticPaths(){return vehicles.filter(v=>v.kind==='new').map(vehicle=>({params:{brand:vehicle.brandSlug,slug:vehicle.slug},props:{vehicle}}));}
interface Props{vehicle:Vehicle;}
const {vehicle}=Astro.props;
const detailedVehicle=assembleVehicleDetails(vehicle);
---
<Base title={vehicleTitle(vehicle)} description={vehicleDescription(detailedVehicle)} image={vehicle.image}>
 <Breadcrumbs items={[{label:'New Cars',href:'/new-cars/'},{label:vehicle.brand,href:brandHref('new',vehicle.brandSlug)},{label:vehicle.name}]}/>
 <VehicleDetail client:load vehicle={detailedVehicle} editorialFocus={productModelFocus(vehicle)} sourcePath={vehicleHref(vehicle)} related={detailRecommendations(vehicle)}/>
 <script type="application/ld+json" set:html={JSON.stringify(vehicleStructuredData(detailedVehicle,Astro.site?.origin))}/>
</Base>
