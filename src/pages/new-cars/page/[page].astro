---
import CatalogPage from '../../../components/CatalogPage.astro';
import {vehicles} from '../../../data/catalog';
export function getStaticPaths(){const count=Math.ceil(vehicles.filter(v=>v.kind==='new').length/12);return Array.from({length:count-1},(_,i)=>({params:{page:String(i+2)},props:{page:i+2}}));}
const {page}=Astro.props;
---
<CatalogPage kind="new" page={page}/>
