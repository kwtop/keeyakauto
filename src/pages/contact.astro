---
import TrustLayout from '../layouts/TrustLayout.astro';
import ContactForm from '../components/ContactForm';
import { ArrowUpRight, Mail, MapPin, Phone } from '@lucide/astro';
import { company } from '../data/company';
import { trustMedia } from '../data/trustMedia';
const office=trustMedia('office-original');
---
<TrustLayout title="Contact us" description="Send KEEYAK a message about vehicle sourcing, an existing order or a visit to our Hangzhou office." label="Contact Us" group="contact" image={trustMedia('office-original').src}>
  <section class="contact-section" id="existing-order" aria-labelledby="contact-title">
    <header class="tc-wrap contact-heading"><h1 id="contact-title">Contact KEEYAK</h1><p>Tell us what you’re looking for, ask about an existing order, or arrange a visit to our Hangzhou office.</p></header>
    <ul class="tc-wrap contact-info" aria-label="Contact details">
      <li><a class="contact-card contact-card--whatsapp" href={company.whatsapp} target="_blank" rel="noopener noreferrer">
        <span class="contact-icon"><img src="/images/brand/whatsapp.svg" width="22" height="22" alt=""/></span>
        <span class="contact-card-label">WhatsApp<ArrowUpRight size={18} aria-hidden="true"/></span><strong>Chat with our team</strong><span class="contact-card-value">{company.phone}</span>
      </a></li>
      <li><a class="contact-card" href={`tel:${company.phone.replace(/\s/g, '')}`}>
        <span class="contact-icon"><Phone size={20} aria-hidden="true"/></span>
        <span class="contact-card-label">Phone</span><strong>Call us</strong><span class="contact-card-value">{company.phone}</span>
      </a></li>
      <li><a class="contact-card" href={`mailto:${company.email}`}>
        <span class="contact-icon"><Mail size={20} aria-hidden="true"/></span>
        <span class="contact-card-label">Email</span><strong>Write to us</strong><span class="contact-card-value">{company.email}</span>
      </a></li>
      <li><div class="contact-card" id="office">
        <span class="contact-icon"><MapPin size={20} aria-hidden="true"/></span>
        <span class="contact-card-label">Office</span><strong>Visit us in Hangzhou</strong><address class="contact-card-value">{company.officeAddress}</address>
      </div></li>
    </ul>
    <div class="tc-wrap contact-message-layout">
      <figure class="contact-office-figure">
        <img src={office.src} width={office.width} height={office.height} alt={office.alt} decoding="async"/>
        <figcaption><strong>Our Hangzhou office</strong><span>Please contact us before arranging your visit.</span></figcaption>
      </figure>
      <div class="contact-form-column" id="contact-message"><ContactForm client:load/></div>
    </div>
  </section>
</TrustLayout>

<style>
  /* Autohaus contact page: left title and intro, a row of contact cards, then a framed photograph beside the message form. */
  .contact-section {
    padding-block: clamp(40px, 6vw, 80px) clamp(56px, 8vw, 104px);
    scroll-margin-top: 108px;
  }
  .contact-section > .tc-wrap { max-width: 1240px; }
  .contact-heading { display: grid; gap: 18px; margin-bottom: clamp(36px, 5vw, 56px); }
  :global(body.inner-autohaus #main) .contact-heading h1 { margin: 0; font-size: var(--heading-task); font-weight: 500; letter-spacing: -.04em; line-height: 1.1; text-align: left; }
  :global(body.inner-autohaus #main) .contact-heading p { max-width: 52ch; margin: 0; color: #606060; font-size: 18px; line-height: 1.8; }
  :global(body.inner-autohaus #main) .contact-info {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin: 0 auto clamp(28px, 4vw, 48px);
    padding: 0;
    list-style: none;
  }
  .contact-info > li { min-width: 0; }
  .contact-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 24px;
    border-radius: 20px;
    background: #f5f5f5;
    color: #212121;
    text-decoration: none !important;
    transition: background-color 180ms;
  }
  a.contact-card:hover { background: #ececec; }
  .contact-card--whatsapp { background: #fff3c4; }
  a.contact-card--whatsapp:hover { background: #ffe98f; }
  .contact-icon { display: grid; place-items: center; width: 44px; height: 44px; margin-bottom: 28px; border-radius: 50%; background: #fff; }
  .contact-card-label { display: flex; align-items: center; justify-content: space-between; color: #606060; font-size: 14px; }
  .contact-card strong { margin: 4px 0 8px; font-size: 20px; font-weight: 500; letter-spacing: -.02em; line-height: 1.3; }
  .contact-card-value { margin-top: auto; overflow-wrap: anywhere; color: #3a3a38; font-size: 15px; font-style: normal; line-height: 1.6; }
  .contact-message-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: stretch;
    gap: clamp(20px, 3vw, 32px);
  }
  .contact-office-figure {
    position: relative;
    min-height: 420px;
    margin: 0;
    overflow: hidden;
    padding: 4px;
    border-radius: 24px;
    background: #fff;
    box-shadow: 0 0 0 1px #2121210d, 0 10px 30px #2121211a;
  }
  .contact-office-figure img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center 40%; border-radius: 20px; }
  :global(body.inner-autohaus #main) .contact-office-figure figcaption {
    position: absolute;
    inset: auto 4px 4px;
    display: grid;
    gap: 4px;
    padding: 80px 28px 24px;
    border-radius: 0 0 20px 20px;
    background: linear-gradient(to top, #000000c8 0%, #00000070 55%, #0000 100%);
    color: #fff;
    text-align: left;
  }
  .contact-office-figure strong { font-size: 22px; font-weight: 500; letter-spacing: -.02em; }
  .contact-office-figure span { color: #ffffffd9; font-size: 15px; }
  .contact-form-column {
    min-width: 0;
    padding: clamp(24px, 3.5vw, 44px);
    border-radius: 24px;
    background: #fff;
    box-shadow: 0 0 0 1px #2121210d, 0 10px 30px #2121211a;
  }
  .contact-form-column :global(.contact-form-card) {
    display: grid;
    gap: 20px;
    max-width: none;
  }
  .contact-form-column :global(.form-row) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    align-items: start;
  }
  .contact-form-column :global(.quote-form label) { gap: 6px; font-size: 15px; }
  .contact-form-column :global(.quote-form :is(input, select, textarea)) {
    border-radius: 12px;
    min-height: 50px;
    padding: 12px 14px;
    background: #f3f3f3;
  }
  .contact-form-column :global(.quote-form :is(input,select,textarea):not([aria-invalid=true])) { border-color: transparent; }
  .contact-form-column :global(.quote-form :is(input,select,textarea):focus) { background: #fff; border-color: #212121; }
  .contact-form-column :global(.quote-form textarea) { min-height: 108px; }
  :global(body.inner-autohaus #main) .contact-form-column :global(h2) { margin: 0; font-size: clamp(26px, 2.4vw, 34px); font-weight: 500; letter-spacing: -.04em; line-height: 1.12; text-align: left; }
  .contact-form-column :global(.contact-form-heading) { display: grid; gap: 8px; margin-bottom: 4px; }
  :global(body.inner-autohaus #main) .contact-form-column :global(.contact-form-heading p) { margin: 0; color: #60615a; font-size: 14px; line-height: 1.6; }
  .contact-form-column :global(.contact-form-card > button) { justify-self: start; }
  .contact-form-column :global(.contact-form-card > .contact-reply-note) { margin: -8px 0 0; font-size: 13px; }
  .contact-form-column :global(.form-error) { font-size: 14px; line-height: 1.45; }
  .contact-form-column :global(.contact-review) { display: grid; margin: 0; }
  .contact-form-column :global(.contact-review > div) { display: grid; grid-template-columns: 108px minmax(0, 1fr); gap: 16px; padding-block: 14px; border-bottom: 1px solid var(--tc-line); font-size: 15px; }
  .contact-form-column :global(.contact-review dt) { color: #62625b; font-weight: 400; }
  .contact-form-column :global(.contact-review dd) {
    margin: 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .contact-form-column :global(.text-link) { justify-self: start; min-height: 44px; padding: 4px 0; border: 0; background: none; color: #212121; font: inherit; font-size: 14px; text-decoration: underline; text-underline-offset: 4px; cursor: pointer; }
  .contact-form-column :global(.inquiry-send) { display: grid; gap: 16px; padding-top: 24px; border-top: 1px solid var(--tc-line); }
  :global(body.inner-autohaus #main) .contact-form-column :global(.inquiry-send h3) { margin: 0; font-size: 20px; line-height: 1.4; }
  .contact-form-column :global(.inquiry-submission-fields) { display: grid; gap: 16px; }
  .contact-form-column :global(.inquiry-honeypot) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .contact-form-column :global(.inquiry-privacy) { display: flex; align-items: flex-start; gap: 10px; font-size: 14px; line-height: 1.6; }
  .contact-form-column :global(.inquiry-privacy input) { flex: 0 0 18px; width: 18px; height: 18px; margin: 3px 0 0; accent-color: #212121; }
  .contact-form-column :global(.inquiry-privacy span) { min-width: 0; }
  :global(body.inner-autohaus #main) .contact-form-column :global(.inquiry-send :is(.form-note,.form-error)) { margin: 0; font-size: 14px; line-height: 1.6; }
  .contact-form-column :global(.inquiry-send [role=alert]) { display: grid; gap: 8px; }
  .contact-form-column :global(.inquiry-send > button) { justify-self: start; }
  .contact-form-column :global(.inquiry-send button:disabled) { opacity: .5; cursor: not-allowed; }
  @media (max-width: 999px) {
    :global(body.inner-autohaus #main) .contact-info { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .contact-message-layout { grid-template-columns: minmax(0, 1fr); }
    .contact-office-figure { order: 2; min-height: 0; }
    .contact-office-figure img { height: auto; aspect-ratio: 16 / 9; }
  }
  @media (max-width: 599px) {
    .contact-card { padding: 20px; }
    .contact-office-figure img { aspect-ratio: 4 / 3; }
    .contact-icon { margin-bottom: 18px; }
    .contact-form-column { padding: 24px 20px; border-radius: 20px; }
    .contact-form-column :global(.contact-form-card > button) { justify-self: stretch; }
  }
  @media (max-width: 479px) {
    :global(body.inner-autohaus #main) .contact-info { grid-template-columns: minmax(0, 1fr); }
    .contact-form-column :global(.form-row) { grid-template-columns: minmax(0, 1fr); gap: 12px; }
  }
</style>
