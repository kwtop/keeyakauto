---
import {company,aboutLinks} from '../../data/company';
import {exportLinks} from '../../data/exportServices';
import {socialLinks} from '../../data/social';
import {ArrowRight} from '@lucide/astro';
const groups=[{title:'New Cars',links:[{label:'Browse models',href:'/new-cars/'},{label:'All brands',href:'/new-cars/brands/'}]},{title:'Used Cars',links:[{label:'Browse models',href:'/used-cars/'},{label:'All brands',href:'/used-cars/brands/'}]},{title:'Export Services',links:[{label:'Service Overview',href:'/export-services/'},...exportLinks]},{title:'Explore',links:[{label:'Vehicle comparisons',href:'/guides/comparisons/'},{label:'Country guides',href:'/export-services/buying-guide/#country-guides'},{label:'Prepare inquiry',href:'/quote/'}]},{title:'Company',links:[...aboutLinks,{label:'Contact Us',href:'/contact/'},{label:'Privacy',href:'/privacy/'},{label:'Website Terms',href:'/terms/'}]}];
---
<footer class="v-footer" id="site-footer"><div class="v-container v-footer-inner">
 <div class="v-footer-directory"><p class="v-footer-statement">Cars from China.<br/>Your next move.</p>{groups.map(g=><nav aria-label={`Footer ${g.title}`}><h2>{g.title}</h2>{g.links.map(l=><a href={l.href}>{l.label}</a>)}</nav>)}</div>
 <div class="v-footer-contact"><div><h2>Start with your requirement</h2><p>Models, quantities and destination. Let’s discuss the next step.</p></div><div><a href={`mailto:${company.email}`}>{company.email}<ArrowRight size={15}/></a><a href={company.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp {company.phone}<ArrowRight size={15}/></a></div></div>
 <div class="v-footer-brand-row"><a href="/" aria-label="KEEYAK home"><img src="/images/brand/keeyak-wordmark-360.webp" srcset="/images/brand/keeyak-wordmark-360.webp 360w, /images/brand/keeyak-wordmark-720.webp 720w" sizes="240px" width="1200" height="219" alt="" loading="lazy"/></a><nav aria-label="KEEYAK social media">{socialLinks.map(s=><a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={`KEEYAK on ${s.label} (opens in a new tab)`}><img src={s.icon} alt="" width="18" height="18" loading="lazy"/></a>)}</nav></div>
 <div class="v-footer-address"><strong>{company.legalName}</strong><address>{company.officeAddress}</address></div>
 <div class="v-footer-bottom"><p>© {new Date().getFullYear()} {company.legalName}</p><nav aria-label="Legal"><a href="/privacy/">Privacy</a><a href="/terms/">Website Terms</a></nav></div>
</div></footer>
