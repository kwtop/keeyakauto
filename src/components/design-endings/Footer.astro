---
import {company,aboutLinks} from '../../data/company';
import {exportLinks} from '../../data/exportServices';
import {socialLinks} from '../../data/social';
interface Props {variant:'a'|'b'}
const {variant}=Astro.props;
const groups=[
 {title:'New Cars',links:[{label:'Browse models',href:'/new-cars/'},{label:'All brands',href:'/new-cars/brands/'}]},
 {title:'Used Cars',links:[{label:'Browse models',href:'/used-cars/'},{label:'All brands',href:'/used-cars/brands/'}]},
 {title:'Export Services',links:[{label:'Service Overview',href:'/export-services/'},...exportLinks]},
 {title:'Explore',links:[{label:'Vehicle comparisons',href:'/guides/comparisons/'},{label:'Country guides',href:'/export-services/buying-guide/#country-guides'},{label:'Prepare inquiry',href:'/quote/'}]},
 {title:'Company',links:[...aboutLinks,{label:'Contact Us',href:'/contact/'}]}
];
---
<footer class={`ep-footer ep-footer--${variant}`} id="site-footer">
 <div class="ep-shell">
  <div class="ep-directory">
   <div class="ep-brand"><a class="ep-logo" href="/" aria-label="KEEYAK home"><img src="/images/brand/keeyak-wordmark.png" width="1200" height="219" alt="" loading="lazy"/></a><div class="ep-brand-copy"><p>{company.legalName}</p><address>{company.officeAddress}</address></div></div>
   <div class="ep-navigation">{groups.map(group=><details class="ep-footer-group" data-ending-directory open><summary>{group.title}<span aria-hidden="true">+</span></summary><nav aria-label={`Footer ${group.title}`}>{group.links.map(link=><a href={link.href}>{link.label}</a>)}</nav></details>)}</div>
  </div>
  <div class="ep-footer-bottom"><p>© {new Date().getFullYear()} {company.legalName}</p><nav class="ep-social" aria-label="KEEYAK social media">{socialLinks.map(s=><a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={`KEEYAK on ${s.label}`}><img src={s.icon} width="18" height="18" alt="" loading="lazy"/></a>)}</nav><nav class="ep-legal" aria-label="Legal"><a href="/privacy/">Privacy</a><a href="/terms/">Website Terms</a></nav></div>
 </div>
</footer>
<script>
 const directories=[...document.querySelectorAll<HTMLDetailsElement>('[data-ending-directory]')];
 const compact=matchMedia('(max-width:809px)');
 const update=()=>directories.forEach(group=>{group.open=!compact.matches;});
 update();compact.addEventListener('change',update);
 directories.forEach(group=>group.querySelector('summary')?.addEventListener('click',event=>{if(!compact.matches)event.preventDefault();}));
</script>
