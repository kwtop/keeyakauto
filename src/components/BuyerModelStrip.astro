---
import BrandLogo from './BrandLogo';
import { vehicles, vehicleHref } from '../data/catalog';
import {modelCoverPhoto} from '../data/modelVisuals';
import {powertrainLabel} from '../data/catalogLabels';
interface Props { title?:string; showCatalogLink?:boolean; }
const {title='More models to explore',showCatalogLink=true}=Astro.props;
const models=['camry','rav4','id-3'].map(slug=>vehicles.find(v=>v.kind==='new'&&v.slug===slug)).filter((v):v is NonNullable<typeof v>=>Boolean(v));
---
<section class="buyer-model-strip shell" data-module="model-reference-paths" data-core-module="model-references" aria-labelledby="buyer-models-heading">
 <header><h2 id="buyer-models-heading">{title}</h2>{showCatalogLink&&<a href="/new-cars/">Browse the new-car range</a>}</header>
 <div class="buyer-models">{models.map(model=><article><a class="buyer-model-photo" href={vehicleHref(model)} tabindex="-1" aria-hidden="true"><img src={modelCoverPhoto(model).src} srcset={modelCoverPhoto(model).srcSet} sizes="(max-width:700px) 45vw, 32vw" alt="" width="1448" height="1086" loading="lazy"/></a><h3 class="brand-title brand-title--compact"><BrandLogo slug={model.brandSlug} name={model.brand}/><a href={vehicleHref(model)}>{model.name}</a></h3><p>{powertrainLabel(model.powertrain)} · Model reference</p></article>)}</div>
</section>
<style>
.buyer-model-strip{padding-block:54px 76px;border-top:1px solid #e2e2e2}.buyer-model-strip header{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-bottom:32px}.buyer-model-strip h2{font:700 36px/1.15 Georgia,'Times New Roman',serif;letter-spacing:-.025em;margin:0}.buyer-model-strip header>a{font-size:16px;text-decoration:underline;text-underline-offset:5px;min-height:44px;display:flex;align-items:center}.buyer-models{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:32px}.buyer-models article{min-width:0}.buyer-model-photo{display:block;background:#fff;border-radius:0;overflow:hidden;aspect-ratio:4/3}.buyer-model-photo img{width:100%;height:100%;object-fit:contain}.buyer-models h3{font-family:var(--body);font-weight:600;font-size:20px;line-height:1.3;letter-spacing:-.02em;margin:16px 0 8px}.buyer-models h3 a:hover{text-decoration:underline;text-underline-offset:5px}.buyer-models p{font-size:16px;color:#454545;margin:0}
@media(max-width:700px){.buyer-model-strip{padding-block:32px 48px}.buyer-model-strip header{display:block;margin-bottom:24px}.buyer-model-strip h2{font-size:27px}.buyer-model-strip header>a{margin-top:12px}.buyer-models{grid-template-columns:1fr;gap:28px}.buyer-models article{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:0 20px;align-items:center}.buyer-model-photo{grid-row:1/3}.buyer-models h3{font-size:20px;align-self:end;margin:0 0 8px}.buyer-models p{align-self:start}}
</style>
