---
import Base from '../layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import CatalogNeeds from './CatalogNeeds.astro';
import ProcurementFigure from './ProcurementFigure.astro';
import ExportFigure from './export/ExportFigure.astro';
import {reviewScene} from './export/exportStoryMedia';
import {vehicles,brands,brandHref,type Vehicle} from '../data/catalog';
import {catalogBrandAsset} from '../data/catalogBrandAssets';
import BrandPopularityBadge from './BrandPopularityBadge';
import {brandPopularityRank,brandPopularityDescription} from '../data/brandPopularity';
import {categoryHref, vehicleCategories, vehicleCategoryLabel} from '../data/vehicleCategories';
import '../styles/catalog-refined.css';
import '../styles/nest-catalog.css';
import '../styles/catalog-discovery.css';
interface Props {kind:Vehicle['kind'];}
const {kind}=Astro.props;const isNew=kind==='new';
const collection=brands(kind).sort((a,b)=>a.name.localeCompare(b.name,'en',{sensitivity:'base'})).map(brand=>({...brand,items:vehicles.filter(v=>v.kind===kind&&v.brandSlug===brand.slug)}));
---
<Base title={isNew?'New car brands from China':'Used car brands from China'} description={isNew?'Browse '+collection.length+' car brands, explore listed models and request a quote for the car you need.':'Explore used-car photographs and vehicle records from '+collection.length+' brands. Compare supplied details and request current availability.'}>
 <div class:list={['catalog-refined',{'catalog-refined--used':!isNew}]}>
 <Breadcrumbs items={[{label:isNew?'New Cars':'Used Cars',href:isNew?'/new-cars/':'/used-cars/'},{label:'Browse Brands'}]}/>
 <header class="shell catalog-heading catalog-heading--discovery" data-core-module="scope"><h1>{isNew?'New cars by brand':'Used cars by brand'}</h1><p>{collection.length} brands.</p></header>
 <section class="shell" data-module="brands" data-core-module="brands"><nav class="catalog-index-categories" aria-label="Browse by category"><span>Browse by category</span>{vehicleCategories.map(category=><a href={categoryHref(kind,category)}>{vehicleCategoryLabel(category)}</a>)}</nav><div class="catalog-brand-index">{collection.map(brand=>{
  const asset=catalogBrandAsset(brand.slug);
  return <a href={brandHref(kind,brand.slug)} data-popular-rank={brandPopularityRank(brand.slug)} aria-description={brandPopularityDescription(brand.slug)}><span class="catalog-menu-mark">{asset?<img src={asset.src} alt="" width="100" height="38" loading="lazy"/>:<span>{brand.name}</span>}</span><BrandPopularityBadge slug={brand.slug}/><h2>{brand.name}</h2><p>{brand.items.length ? `${brand.items.length} ${brand.items.length===1?'model':'models'}` : 'Request a model'}</p></a>;
 })}</div></section>
 {isNew?<CatalogNeeds compact/>:<section class="shell brand-purchase-story" data-module="cross-brand-choice" data-core-module="selection"><ProcurementFigure scene="inspection" caption="Compare model references, then request records for each car offered."/><div class="brand-purchase-copy"><h2>Compare models across brands</h2><p>Browse by body type or powertrain. Include acceptable alternatives in your request.</p><p>Compare the year, mileage, condition and equipment of the individual cars offered. Use the records for each car to verify those details.</p><div class="catalog-text-links"><a href="/used-cars/?category=SUV">SUV references</a><a href="/used-cars/?category=Sedan">{vehicleCategoryLabel('Sedan')}</a><a href="/used-cars/?power=Pure+Electric">Electric references</a></div></div></section>}
 <section class="shell catalog-closing catalog-closing--illustrated" data-module="inquiry" data-core-module="inquiry"><ExportFigure {...reviewScene} class="catalog-brief-photo" caption=""/><div><h2>Request a vehicle quote</h2><p>Share the brand, model, preferred version, quantity and destination.</p><a href={isNew?'/new-cars/':'/used-cars/'}>Browse all models</a><a class="button button-dark" href={isNew?'/quote/?kind=new':'/quote/?kind=used'}>Request a quote</a></div></section>
 </div>
</Base>
