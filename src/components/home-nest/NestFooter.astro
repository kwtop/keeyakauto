---
import { company, aboutLinks } from '../../data/company';
import { exportLinks } from '../../data/exportServices';
import { socialLinks } from '../../data/social';
const groups=[
 {title:'New Cars',href:'/new-cars/',links:[{label:'Browse models',href:'/new-cars/'},{label:'All brands',href:'/new-cars/brands/'}]},
 {title:'Used Cars',href:'/used-cars/',links:[{label:'Browse models',href:'/used-cars/'},{label:'All brands',href:'/used-cars/brands/'}]},
 {title:'Export Services',href:'/export-services/',links:[{label:'Service Overview',href:'/export-services/'},...exportLinks,{label:'Vehicle comparisons',href:'/guides/comparisons/'},{label:'Country guides',href:'/export-services/buying-guide/#country-guides'}]},
 {title:'About Us',href:'/about/',links:aboutLinks}
];
---
<footer id="site-footer" class="nest-footer">
  <div class="nest-container nest-footer-help">
    <div><h2>Let’s talk cars.</h2><p>Have a model in mind, or need help getting started?</p><a href={`mailto:${company.email}`}>{company.email}</a><a href={company.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp {company.phone}</a></div>
    <nav class="nest-footer-social" aria-label="KEEYAK social media">{socialLinks.map(link=><a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={`KEEYAK on ${link.label} (opens in a new tab)`}><img src={link.icon} alt="" width="24" height="24" loading="lazy"/></a>)}</nav>
  </div>
  <div class="nest-container nest-footer-directory">
    <nav class="nest-footer-navigation" aria-label="Footer navigation">{groups.map((group,index)=><div class="nest-footer-group"><h3><span class="nest-footer-group-title">{group.title}</span><button class="nest-footer-toggle" type="button" aria-expanded="true" aria-controls={`nest-footer-links-${index}`}>{group.title}<span aria-hidden="true">−</span></button></h3><ul id={`nest-footer-links-${index}`}>{group.links.map(link=><li><a href={link.href}>{link.label}</a></li>)}</ul></div>)}</nav>
    <div class="nest-footer-company"><a class="nest-footer-wordmark" href="/" aria-label="KEEYAK home"><img src="/images/brand/keeyak-wordmark.png" width="1200" height="219" alt="" loading="lazy"/></a><p>{company.legalName}</p><address>{company.officeAddress}</address><a class="nest-inline-link" href="/contact/">Contact Us</a></div>
  </div>
  <div class="nest-container nest-footer-bottom"><span>© {new Date().getFullYear()} {company.legalName}</span><nav aria-label="Legal"><a href="/privacy/">Privacy</a><a href="/terms/">Website Terms</a></nav></div>
</footer>
<script>
 const footerMedia=window.matchMedia('(min-width: 768px)');
 const footerButtons=Array.from(document.querySelectorAll<HTMLButtonElement>('.nest-footer-toggle'));
 const setFooterGroup=(button:HTMLButtonElement,open:boolean)=>{
  button.setAttribute('aria-expanded',String(open));
  const list=document.getElementById(button.getAttribute('aria-controls')||'');if(list)list.hidden=!open;
  const sign=button.querySelector('span');if(sign)sign.textContent=open?'−':'+';
 };
 const updateFooter=()=>footerButtons.forEach(button=>setFooterGroup(button,footerMedia.matches));
 updateFooter();footerMedia.addEventListener('change',updateFooter);
 footerButtons.forEach(button=>button.addEventListener('click',()=>{if(!footerMedia.matches)setFooterGroup(button,button.getAttribute('aria-expanded')!=='true');}));
</script>
