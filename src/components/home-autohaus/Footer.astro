---
import {Mail, MapPin} from '@lucide/astro';
import {company,aboutLinks} from '../../data/company';
import {exportLinks} from '../../data/exportServices';
import {socialLinks} from '../../data/social';
import '../../styles/site-footer.css';
const groups=[
 {title:'New Cars',links:[{label:'Browse models',href:'/new-cars/'},{label:'All brands',href:'/new-cars/brands/'}]},
 {title:'Used Cars',links:[{label:'Browse models',href:'/used-cars/'},{label:'All brands',href:'/used-cars/brands/'}]},
 {title:'Export Services',links:[{label:'Service Overview',href:'/export-services/'},...exportLinks]},
 {title:'Explore',links:[{label:'Vehicle comparisons',href:'/guides/comparisons/'},{label:'Country guides',href:'/export-services/buying-guide/#country-guides'},{label:'Request a quote',href:'/quote/'}]},
 {title:'Company',links:[...aboutLinks,{label:'Contact Us',href:'/contact/'}]}
];
---
<footer class="ah-ending-footer" id="site-footer">
 <div class="ah-ending-shell">
  <div class="ah-ending-directory">
   <div class="ah-ending-brand">
    <a class="ah-ending-logo" href="/" aria-label="KEEYAK home"><img src="/images/brand/keeyak-wordmark-360.webp" srcset="/images/brand/keeyak-wordmark-360.webp 360w, /images/brand/keeyak-wordmark-720.webp 720w" sizes="240px" width="1200" height="219" alt="" loading="lazy"/></a>
    <div class="ah-ending-brand-copy">
     <p>{company.legalName}</p>
     <address><MapPin size={16} aria-hidden="true"/><span>{company.officeAddress}</span></address>
     <div class="ah-ending-contact">
      <a href={`mailto:${company.email}`}><Mail size={16} aria-hidden="true"/><span>{company.email}</span></a>
      <a href={company.whatsapp} target="_blank" rel="noopener noreferrer" aria-label={`WhatsApp ${company.phone}`}><img src="/images/brand/whatsapp.svg" width="16" height="16" alt=""/><span>{company.phone}</span></a>
     </div>
    </div>
   </div>
   <div class="ah-ending-navigation">{groups.map(group=><details class="ah-ending-group" data-home-footer-directory open><summary>{group.title}<span aria-hidden="true">+</span></summary><nav aria-label={`Footer ${group.title}`}>{group.links.map(link=><a href={link.href}>{link.label}</a>)}</nav></details>)}</div>
  </div>
  <div class="ah-ending-bottom">
   <p>© {new Date().getFullYear()} {company.legalName}</p>
   <nav class="ah-ending-social" aria-label="KEEYAK social media">{socialLinks.map(s=><a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={`KEEYAK on ${s.label}`}><img src={s.icon} width="18" height="18" alt="" loading="lazy"/></a>)}</nav>
   <nav class="ah-ending-legal" aria-label="Legal"><a href="/privacy/">Privacy</a><a href="/terms/">Website Terms</a></nav>
  </div>
 </div>
</footer>
<script>
 const homeFooterGroups=[...document.querySelectorAll<HTMLDetailsElement>('[data-home-footer-directory]')];
 const homeFooterCompact=matchMedia('(max-width:809px)');
 const updateHomeFooter=()=>homeFooterGroups.forEach(group=>{group.open=!homeFooterCompact.matches;});
 updateHomeFooter();homeFooterCompact.addEventListener('change',updateHomeFooter);
 homeFooterGroups.forEach(group=>group.querySelector('summary')?.addEventListener('click',event=>{if(!homeFooterCompact.matches)event.preventDefault();}));
</script>
