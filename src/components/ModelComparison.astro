---
import {vehicleHref,type Vehicle} from '../data/catalog';
import {vehicleDisplayImage} from '../data/imageDelivery';
import {bodyGroupLabel} from '../data/catalogLabels';
interface Props {items:Vehicle[];title?:string;}
const {items,title='Compare models'}=Astro.props;
const showSeats=items.some(v=>v.seats);
---
<section class="section section-soft" data-module="model-differences"><div class="shell"><div class="content-section-head"><div><h2>{title}</h2><p>These specifications describe the listed models. Confirm the exact version in your quotation before ordering.</p></div></div>{items.length===1?<div class="content-split"><img src={vehicleDisplayImage(items[0].image)} alt={items[0].name+' model reference'} width="1400" height="1050" loading="lazy" style="border-radius:var(--card-radius)"/><div><h3>{items[0].name}</h3><dl class="model-summary"><div><dt>Listed year</dt><dd>{items[0].year}</dd></div><div><dt>Body</dt><dd>{bodyGroupLabel(items[0].body,items[0].kind)}</dd></div><div><dt>Powertrain</dt><dd>{items[0].powertrain}</dd></div>{showSeats&&<div><dt>Seats</dt><dd>{items[0].seats}</dd></div>}</dl><div class="content-actions"><a class="button button-outline" href={vehicleHref(items[0])}>View model details</a></div></div></div>:<div class="table-wrap"><table class="data-table model-comparison"><thead><tr><th scope="col">Model</th><th scope="col">Listed year</th><th scope="col">Body</th><th scope="col">Powertrain</th>{showSeats&&<th scope="col">Seats</th>}</tr></thead><tbody>{items.map(v=><tr><td><img src={vehicleDisplayImage(v.image)} alt="" width="130" height="98" loading="lazy"/><a href={vehicleHref(v)}>{v.name}</a></td><td>{v.year}</td><td>{bodyGroupLabel(v.body,v.kind)}</td><td>{v.powertrain}</td>{showSeats&&<td>{v.seats||'To confirm'}</td>}</tr>)}</tbody></table></div>}</div></section>
