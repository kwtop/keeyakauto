---
interface Props { title:string; body:string; href?:string; label?:string; secondaryHref?:string; secondaryLabel?:string; }
const {title,body,href='/quote/',label='Prepare an inquiry',secondaryHref,secondaryLabel}=Astro.props;
---
<section class="au-action au-soft" data-module="next-step">
  <div class="au-wrap au-action-grid"><div><h2>{title}</h2><p>{body}</p></div><div class="au-actions"><a class="button button-dark" href={href}>{label}</a>{secondaryHref&&<a class="button button-outline" href={secondaryHref}>{secondaryLabel}</a>}</div></div>
</section>
