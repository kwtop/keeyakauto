---
import {X} from '@lucide/astro';
import {companyDocuments} from '../../data/company';
import documentMedia from '../../data/aboutMedia.json';
import type {TrustBlock} from '../../data/trustContent';
import '../../styles/company-profile.css';
interface Props {block:TrustBlock;}
const {block}=Astro.props;
type DocumentImage={src:string;srcset:string;width:number;height:number};
const media=documentMedia as Record<string,DocumentImage>;
const assessment=media['/images/company/jingyan-sgs-assessment-2026.webp'];
const assessmentOriginal='/images/company/jingyan-sgs-assessment-2026-original.jpg';
const assessmentTitle='SGS supplier assessment';
const assessmentKind=block.items?.find(item=>item.title==='Assessment')?.body;
const facts=block.items?.filter(item=>item.title!=='Assessment')??[];
const assessmentDescription=[assessmentKind,...facts.map(item=>`${item.title}: ${item.body}`),block.takeaway?.body,'Both certificate layouts refer to the same assessment.'].filter(Boolean).join(' ');
const records=companyDocuments.filter(document=>document.image!=='supplier-certificate-2026').map(document=>({
 ...document,
 category:document.image==='alibaba-fy26-recognition'?'Platform recognition':'Exhibition participation',
 original:`/images/company/records/${document.image}-original.jpg`,
 asset:media[`/images/company/records/${document.image}.webp`]
}));
---
<section class="cp-credentials ap-section" id={block.id} data-company-documents data-core-module data-module={block.id} aria-labelledby="company-documents-title">
 <div class="ap-wrap">
  <header class="ap-heading" data-ap-reveal><h2 id="company-documents-title">Credentials and records</h2></header>
  <div class="cp-document-list">
  <article class="cp-assessment" data-ap-reveal>
   <a class="cp-assessment-paper" href={assessmentOriginal} target="_blank" rel="noopener noreferrer" data-document-preview data-document-title={assessmentTitle} data-document-description={assessmentDescription} data-assessment aria-label="Preview original SGS supplier assessment, record 489102251_T"><img {...assessment} sizes="(min-width:1024px) 864px, calc(100vw - 64px)" alt="Original SGS Gold Plus Supplier Assessment Certificate for Zhejiang Jingyan Technology Co., Ltd., record 489102251_T" loading="lazy" decoding="async"/></a>
   <div class="cp-assessment-caption">
    <h3>SGS supplier assessment</h3>
   </div>
  </article>
  <div class="cp-record-grid">{records.map(document=><article class="cp-document-card" data-ap-reveal>
   <a class="cp-document-preview" href={document.original} target="_blank" rel="noopener noreferrer" data-document-preview data-document-title={document.name} data-document-description={`${document.category}. Printed holder: ${document.holder}. ${document.description}`} aria-label={`Preview ${document.name}`}>
    <div class="cp-document-well" data-orientation={document.asset.height > document.asset.width ? 'portrait' : 'landscape'}><img {...document.asset} sizes="(max-width:639px) calc(50vw - 37px), (min-width:1200px) 330px, 30vw" alt={`${document.name}; printed holder: ${document.holder}`} loading="lazy" decoding="async"/></div>
    <div class="cp-document-caption"><h4>{document.name}</h4></div>
   </a>
  </article>)}</div>
  </div>
 </div>
 <dialog class="cp-document-viewer" aria-labelledby="company-document-viewer-title" aria-describedby="company-document-viewer-description">
  <header><div><h2 id="company-document-viewer-title">Original company document</h2><p id="company-document-viewer-description"></p></div><form method="dialog"><button type="submit" aria-label="Close document preview" autofocus><X size={23}/></button></form></header>
  <div class="cp-document-viewer-image"><p role="status" data-document-loading>Loading original document...</p><img data-document-full alt="" hidden/></div>
  <footer><a data-document-alternative href="/images/company/records/supplier-certificate-2026-original.jpg" target="_blank" rel="noopener noreferrer" hidden>Alternative layout</a><a data-document-original target="_blank" rel="noopener noreferrer">Open original file</a></footer>
 </dialog>
</section>
<script>
 const root=document.querySelector<HTMLElement>('[data-company-documents]');
 const viewer=root?.querySelector<HTMLDialogElement>('dialog');
 const image=viewer?.querySelector<HTMLImageElement>('[data-document-full]');
 const title=viewer?.querySelector<HTMLElement>('#company-document-viewer-title');
 const description=viewer?.querySelector<HTMLElement>('#company-document-viewer-description');
 const loading=viewer?.querySelector<HTMLElement>('[data-document-loading]');
 const original=viewer?.querySelector<HTMLAnchorElement>('[data-document-original]');
 const alternative=viewer?.querySelector<HTMLAnchorElement>('[data-document-alternative]');
 if(root&&viewer&&image&&title&&description&&loading&&original){
  let trigger:HTMLAnchorElement|undefined;
  const reveal=()=>{loading.hidden=true;image.hidden=false;};
  image.addEventListener('load',reveal);
  image.addEventListener('error',()=>{image.hidden=true;loading.hidden=false;loading.textContent='The image could not load. Open the original file in a new tab.';});
  root.querySelectorAll<HTMLAnchorElement>('a[data-document-preview]').forEach(link=>link.addEventListener('click',event=>{
   if(event.button!==0||event.ctrlKey||event.metaKey||event.shiftKey||event.altKey||typeof viewer.showModal!=='function')return;
   event.preventDefault();trigger=link;
   title.textContent=link.dataset.documentTitle||'Original company document';
   description.textContent=link.dataset.documentDescription||'';
   if(alternative)alternative.hidden=!link.hasAttribute('data-assessment');
   original.href=link.href;image.alt=title.textContent;
   image.hidden=true;loading.hidden=false;loading.textContent='Loading original document...';image.src=link.href;
   viewer.showModal();if(image.complete&&image.naturalWidth)reveal();
  }));
  viewer.addEventListener('close',()=>trigger?.focus({preventScroll:true}));
  viewer.addEventListener('click',event=>{const box=viewer.getBoundingClientRect();if(event.clientX<box.left||event.clientX>box.right||event.clientY<box.top||event.clientY>box.bottom)viewer.close();});
 }
</script>
