---
import AboutFigure from './AboutFigure.astro';
import { eventHref,type CompanyEvent } from '../../data/companyNews';
interface Props { event:CompanyEvent; }
const {event}=Astro.props;
const image=event.slug==='vietnam-exhibition-2026'?{src:'/images/company/about-selected/vietnam-booth-2026-wide.webp',alt:'The KEEYAK exhibition booth in Vietnam in May 2026'}:event.slug==='indonesia-exhibition-2024'?event.images[2]:event.images[0];
---
<article class="au-related-record" data-record-slug={event.slug}>
  <AboutFigure src={image.src} alt={image.alt} href={eventHref(event)} class="au-related-photo" sizes="(max-width: 700px) 128px, 160px"/>
  <div class="au-related-copy"><p class="au-meta"><time datetime={event.date}>{event.dateLabel}</time><span>{event.location}</span></p><h3><a href={eventHref(event)}>{event.title}</a></h3><a class="au-link" href={eventHref(event)}>Read the report</a></div>
</article>
