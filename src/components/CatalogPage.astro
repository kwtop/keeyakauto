---
import Base from '../layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import VehicleExplorer from './VehicleExplorer';
import ExportFigure from './export/ExportFigure.astro';
import {reviewScene} from './export/exportStoryMedia';
import {vehicles,type Vehicle} from '../data/catalog';
import {catalogCardData} from '../data/catalogCardData';
import '../styles/catalog-refined.css';
import '../styles/nest-catalog.css';
interface Props {kind:Vehicle['kind'];page?:number;}
const {kind,page=1}=Astro.props;const isNew=kind==='new';
const items=vehicles.filter(v=>v.kind===kind);
const pictureInquiry=true;
---
<Base title={(isNew?'New cars from China':'Used cars from China')+(page>1?' · Page '+page:'')} description={isNew?'Browse new cars by brand, body type and powertrain. Compare models and request a quote for the version you need.':'Browse used-car photographs, supplied mileage and registration details. Compare vehicles and request current availability and condition records.'}>
 <div class:list={['catalog-refined','catalog-showroom',{'catalog-refined--used':!isNew}]}>
 <Breadcrumbs items={page>1?[{label:isNew?'New Cars':'Used Cars',href:isNew?'/new-cars/':'/used-cars/'},{label:'Page '+page}]:[{label:isNew?'New Cars':'Used Cars'}]}/>
 <header class="shell catalog-heading catalog-heading--discovery" data-core-module="scope"><h1>{isNew?'New cars from KEEYAK':'Used cars from KEEYAK'}</h1></header>
 <section class="shell catalog-results" data-module="catalog" data-core-module="results"><VehicleExplorer client:load items={items.map(catalogCardData)} initialPage={page} basePath={isNew?'/new-cars/':'/used-cars/'}/></section>
 <section class:list={['shell','catalog-closing',{'catalog-closing--illustrated':pictureInquiry}]} data-module="inquiry" data-core-module="inquiry">
 {pictureInquiry&&<ExportFigure {...reviewScene} class="catalog-brief-photo" caption=""/>}
 <div><h2>{isNew?'Request a vehicle quote':'Request used-car details'}</h2><p>{isNew?'Send the version you want, how many cars you need and where they’re going. You can ask about models outside the catalog.':'Tell us which models you want, what condition you’ll accept and where the cars are going.'}</p><a class="button button-dark" href={isNew?'/quote/?kind=new':'/quote/?kind=used'}>Start an inquiry</a></div></section>
 </div>
</Base>
