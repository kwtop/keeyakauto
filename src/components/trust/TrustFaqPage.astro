---
import {ArrowRight,ChevronDown,Search,X} from '@lucide/astro';
import TrustLayout from '../../layouts/TrustLayout.astro';
import TrustBlock from './TrustBlock.astro';
import {exportFaqGroups} from '../../data/exportServices';
import {trustMedia} from '../../data/trustMedia';
import '../../styles/export-illustrated.css';
const before=exportFaqGroups.filter(group=>['choosing','ordering','inspection'].includes(group.id));
const after=exportFaqGroups.filter(group=>['shipping','support'].includes(group.id));
const sections=[{id:'E6-02',title:'Before you order',groups:before},{id:'E6-03',title:'Shipping and after-sales',groups:after}];
---
<TrustLayout title="Frequently asked questions" label="FAQ" group="export" pageType="FAQPage" modified="2026-10-28" questions={exportFaqGroups.flatMap(group=>group.questions)} description="Answers to 26 car sourcing and export questions: stock, quotations, payment, inspection reports, EVs, shipping documents and support after delivery." image={trustMedia('records').src}>
 <div class="tc-faq-app">
  <section class="tc-wrap tc-opening" data-core-module data-module="E6-01" aria-labelledby="tc-page-title">
   <div class="tc-opening-copy"><div><h1 id="tc-page-title">Frequently asked questions</h1></div><div><form class="tc-search" role="search" aria-label="Search export questions"><label for="trust-faq-search">Search all 26 questions and answers</label><div><Search size={19}/><input id="trust-faq-search" type="search" placeholder="Models, payment, shipping..." autocomplete="off" maxlength="120"/><button type="button" data-clear-search aria-label="Clear search" hidden><X size={18}/></button></div><p data-search-status role="status" aria-live="polite" hidden></p></form></div></div>

  </section>
  <div class="tc-wrap tc-empty" data-search-empty hidden><h2>No matching questions</h2><p>Try another word or return to all questions.</p><button class="tc-button" type="button" data-clear-search>Show all questions</button></div>
  <div class="tc-wrap tc-faq-layout">
   <nav class="tc-faq-toc" aria-label="Question topics">{sections.map(section=><div><p>{section.title}</p><ul>{section.groups.map(group=><li><a href={`#${group.id}`}>{group.title.replaceAll('-','\u2011')}<span>{group.questions.length}</span></a></li>)}</ul></div>)}</nav>
   <div class="tc-faq-main">{sections.map(section=>
    <section class="tc-faq-section" data-core-module data-module={section.id} data-faq-section aria-labelledby={`${section.id}-title`}>
     <h2 id={`${section.id}-title`}>{section.title}</h2>
     {section.groups.map(group=><div id={group.id} class="tc-faq-group" data-faq-group><h3>{group.title}</h3><div class="tc-questions">{group.questions.map((faq,index)=><details id={`faq-${group.id}-${index+1}`} data-faq-question><summary>{faq.question}<ChevronDown size={19}/></summary><p>{faq.answer}</p></details>)}</div><a class="tc-faq-more" href={group.href}>{group.linkLabel}<ArrowRight size={16}/></a></div>)}
    </section>
   )}</div>
  </div>
  <TrustBlock block={{id:'E6-04',title:'Ask the KEEYAK team',body:'Tell us what you would like to buy, or get help with an existing order.',kind:'contact',links:[{label:'Request a quote',href:'/quote/'},{label:'Existing order support',href:'/export-services/after-sales/'}]}}/>
 </div>
</TrustLayout>
<style>
 :global(body.inner-autohaus #main) .tc-faq-app .tc-opening{max-width:1120px}
 :global(body.inner-autohaus #main) .tc-faq-app .tc-opening-copy{align-items:end;gap:24px}
 :global(body.inner-autohaus #main) .tc-faq-app .tc-opening h1{font-size:var(--heading-task)}
 :global(body.inner-autohaus #main) .tc-faq-app .tc-search{
  grid-template-columns:minmax(0,1fr);
  padding:16px;
  border-radius:var(--ed-panel-radius);
  background:var(--surface);
 }
 /* Topic list on the left, questions on the right; neither adds a sticky navigation layer. */
 .tc-faq-layout{display:grid;grid-template-columns:240px minmax(0,1fr);gap:56px;align-items:start;max-width:1120px;padding-bottom:clamp(48px,6vw,80px)}
 .tc-faq-toc{display:grid;gap:24px}
 :global(body.inner-autohaus #main) .tc-faq-toc p{margin:0 0 8px;color:#65635e;font-size:12px;font-weight:600;letter-spacing:.06em;text-transform:uppercase}
 .tc-faq-toc ul{display:grid;gap:2px;margin:0;padding:0;list-style:none}
 .tc-faq-toc a{display:flex;justify-content:space-between;gap:12px;padding:8px 12px;border-radius:10px;color:#212121;font-size:15px;line-height:1.4;text-decoration:none!important}
 .tc-faq-toc a:hover{background:#f5f4f0}
 .tc-faq-toc a span{flex:none;color:#8a8780;font-size:14px;font-variant-numeric:tabular-nums}
 .tc-faq-section+.tc-faq-section{margin-top:56px;padding-top:40px;border-top:1px solid #e4e4e0}
 :global(body.inner-autohaus #main) .tc-faq-section>h2{margin:0 0 20px;color:#65635e;font-size:13px;font-weight:600;letter-spacing:.06em;line-height:1.4;text-transform:uppercase}
 :global(body.inner-autohaus #main) .tc-faq-app .tc-faq-group{display:block}
 :global(body.inner-autohaus #main) .tc-faq-app .tc-faq-group+.tc-faq-group{margin-top:44px}
 :global(body.inner-autohaus #main) .tc-faq-app .tc-faq-group>h3{margin:0 0 12px;font-size:clamp(22px,2.2vw,28px)}
 .tc-faq-more{display:inline-flex;align-items:center;gap:6px;margin-top:16px;color:#212121!important;font-size:14px;font-weight:500;text-decoration:underline!important;text-underline-offset:4px}
 @media(max-width:899px){
  .tc-faq-layout{grid-template-columns:minmax(0,1fr);gap:28px}
  .tc-faq-toc{position:static;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
 }
 @media(max-width:599px){.tc-faq-toc{grid-template-columns:minmax(0,1fr)}}
 @media(max-width:480px){
  :global(body.inner-autohaus #main) .tc-faq-app .tc-search{padding:12px}
  :global(body.inner-autohaus #main) .tc-faq-app .tc-search>div{gap:8px;padding-inline:12px}
 }
</style>
<script>
 const root=document.querySelector<HTMLElement>('.tc-faq-app');
 const input=root?.querySelector<HTMLInputElement>('#trust-faq-search');
 if(root&&input){
  const questions=[...root.querySelectorAll<HTMLDetailsElement>('[data-faq-question]')];
  const originalState=new Map<HTMLDetailsElement,boolean>();
  let searching=false;
  const update=()=>{
   const term=input.value.trim().toLocaleLowerCase('en');
   if(term&&!searching){questions.forEach(item=>originalState.set(item,item.open));searching=true;}
   let matches=0;
   questions.forEach(item=>{const match=!term||(item.textContent||'').toLocaleLowerCase('en').includes(term);item.hidden=!match;if(match)matches++;if(term)item.open=match;else if(searching)item.open=originalState.get(item)||false;});
   if(!term)searching=false;
   root.querySelectorAll<HTMLElement>('[data-faq-group]').forEach(group=>group.hidden=![...group.querySelectorAll<HTMLDetailsElement>('[data-faq-question]')].some(item=>!item.hidden));
   root.querySelectorAll<HTMLElement>('[data-faq-section]').forEach(section=>section.hidden=![...section.querySelectorAll<HTMLElement>('[data-faq-group]')].some(group=>!group.hidden));
   const status=root.querySelector<HTMLElement>('[data-search-status]');if(status){status.hidden=!term;status.textContent=`${matches} ${matches===1?'question':'questions'} found`;}
   const empty=root.querySelector<HTMLElement>('[data-search-empty]');if(empty)empty.hidden=matches>0;
   const clear=root.querySelector<HTMLButtonElement>('.tc-search [data-clear-search]');if(clear)clear.hidden=!term;
  };
  input.addEventListener('input',update);
  root.querySelector('form')?.addEventListener('submit',event=>event.preventDefault());
  root.querySelectorAll<HTMLButtonElement>('[data-clear-search]').forEach(button=>button.addEventListener('click',()=>{input.value='';update();input.focus();}));
  const openHash=()=>{const match=questions.find(item=>item.id===location.hash.slice(1));if(match){input.value='';update();match.open=true;requestAnimationFrame(()=>match.scrollIntoView({block:'start',behavior:'instant'}));}};
  window.addEventListener('hashchange',openHash);
  window.addEventListener('load',openHash,{once:true});
  openHash();
 }
</script>
