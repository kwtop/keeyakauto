---
import {companyDocuments} from '../../data/company';
import {trustPages} from '../../data/trustContent';
import media from '../../data/aboutMedia.json';
import StudyIcon from './StudyIcon.astro';
type DocumentAsset={src:string;srcset:string;width:number;height:number};
const assets=media as Record<string,DocumentAsset>;
const documents=companyDocuments.filter(item=>item.image!=='supplier-certificate-2026');
const assessment=assets['/images/company/jingyan-sgs-assessment-2026.webp'];
const original='/images/company/jingyan-sgs-assessment-2026-original.jpg';
const assessmentBlock=trustPages.company.blocks.find(block=>block.id==='company-documents')!;
const facts=assessmentBlock.items?.filter(item=>item.title!=='Assessment')??[];
---
<section class="study-credentials study-section" id="company-documents" data-study-documents aria-labelledby="study-documents-title"><div class="study-wrap">
 <div class="section-heading" data-study-reveal><div><p class="eyebrow caption-1"><span class="study-dot"></span>Company records</p><h2 class="heading-2" id="study-documents-title">The documents,<br/>in the open.</h2></div><p class="body-3 section-aside">One supplier assessment, five exhibition records and one platform recognition. All available as originals.</p></div>
 <article class="assessment-feature" data-study-reveal>
  <a class="assessment-image" href={original} target="_blank" rel="noopener noreferrer" data-study-preview data-document-title="SGS supplier assessment" data-document-description="SGS Gold Plus Supplier Assessment Certificate. Record 489102251_T." aria-label="Preview SGS supplier assessment"><img {...assessment} sizes="(min-width:1000px) 600px, (min-width:700px) 45vw, 90vw" alt="Original SGS Gold Plus Supplier Assessment Certificate for Zhejiang Jingyan Technology Co., Ltd., record 489102251_T" loading="lazy"/></a>
  <div class="assessment-copy"><span class="verified-label caption-1"><StudyIcon name="verified"/>Supplier assessment</span><h3 class="heading-3">SGS Gold Plus<br/>Supplier Assessment</h3><dl>{facts.map(fact=><div><dt class="caption-2">{fact.title}</dt><dd class={fact.title==='Record number'?'title-2 numeric':'body-3'}>{fact.body}</dd></div>)}</dl><a class="study-text-link title-3" href={original} data-study-preview data-document-title="SGS supplier assessment" data-document-description="SGS Gold Plus Supplier Assessment Certificate. Record 489102251_T." target="_blank" rel="noopener noreferrer">View the original assessment</a><a class="assessment-alternative caption-2" href="/images/company/records/supplier-certificate-2026-original.jpg" data-study-preview data-document-title="SGS assessment, alternative layout" data-document-description="The same supplier assessment, record 489102251_T." target="_blank" rel="noopener noreferrer">Alternative layout of the same assessment</a></div>
 </article>
 <div class="document-grid">{documents.map(document=>{
  const asset=assets[`/images/company/records/${document.image}.webp`];
  return <article class="document-card" data-study-reveal><a class="document-link" href={`/images/company/records/${document.image}-original.jpg`} target="_blank" rel="noopener noreferrer" data-study-preview data-document-title={document.name} data-document-description={`Printed holder: ${document.holder}. ${document.description}`} aria-label={`Preview ${document.name}`}><div class="document-image"><img {...asset} sizes="(min-width:1100px) 360px, (min-width:700px) 42vw, 44vw" alt={`${document.name}; printed holder: ${document.holder}`} loading="lazy"/></div><h3 class="title-3">{document.name}</h3></a></article>;
 })}</div>
 <p class="document-scope body-6"><StudyIcon name="file"/>{assessmentBlock.takeaway?.body}</p>
</div>
<dialog class="study-document-viewer" aria-labelledby="study-viewer-title" aria-describedby="study-viewer-description"><header><div><h2 class="heading-5" id="study-viewer-title">Original document</h2><p class="caption-2" id="study-viewer-description"></p></div><form method="dialog"><button type="submit" aria-label="Close document preview" autofocus><StudyIcon name="close"/></button></form></header><div class="viewer-image"><div class="document-skeleton" role="status">Loading original document…</div><img data-full-document alt="" hidden/></div><footer class="caption-2"><span>Original company record</span><a class="study-text-link title-4" data-original-document target="_blank" rel="noopener noreferrer">Open original file</a></footer></dialog>
</section>
<script>
 const root=document.querySelector<HTMLElement>('[data-study-documents]');
 const viewer=root?.querySelector<HTMLDialogElement>('dialog');
 const image=viewer?.querySelector<HTMLImageElement>('[data-full-document]');
 const title=viewer?.querySelector<HTMLElement>('#study-viewer-title');
 const description=viewer?.querySelector<HTMLElement>('#study-viewer-description');
 const loading=viewer?.querySelector<HTMLElement>('[role="status"]');
 const original=viewer?.querySelector<HTMLAnchorElement>('[data-original-document]');
 if(root&&viewer&&image&&title&&description&&loading&&original){
  let trigger:HTMLAnchorElement|undefined;
  const reveal=()=>{loading.hidden=true;image.hidden=false;};
  image.addEventListener('load',reveal);
  image.addEventListener('error',()=>{image.hidden=true;loading.hidden=false;loading.classList.add('document-error');loading.textContent='The image could not load. Open the original file in a new tab.';});
  root.querySelectorAll<HTMLAnchorElement>('a[data-study-preview]').forEach(link=>link.addEventListener('click',event=>{
   if(event.button!==0||event.ctrlKey||event.metaKey||event.shiftKey||event.altKey||typeof viewer.showModal!=='function')return;
   event.preventDefault();trigger=link;
   title.textContent=link.dataset.documentTitle||'Original company document';description.textContent=link.dataset.documentDescription||'';
   original.href=link.href;image.alt=title.textContent;image.hidden=true;loading.hidden=false;loading.classList.remove('document-error');loading.textContent='Loading original document…';image.src=link.href;
   viewer.showModal();if(image.complete&&image.naturalWidth)reveal();
  }));
  viewer.addEventListener('close',()=>trigger?.focus({preventScroll:true}));
  viewer.addEventListener('click',event=>{const box=viewer.getBoundingClientRect();if(event.clientX<box.left||event.clientX>box.right||event.clientY<box.top||event.clientY>box.bottom)viewer.close();});
 }
</script>
