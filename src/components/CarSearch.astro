---
import {Search,X} from '@lucide/astro';
import {vehicles,vehicleHref} from '../data/catalog';
---
<button class="car-search-trigger" type="button" aria-label="Search cars"><Search size={21}/></button>
<dialog class="car-search" aria-labelledby="car-search-title"><div class="car-search-heading"><h2 id="car-search-title">Find a car</h2><button class="car-search-close" type="button" aria-label="Close car search"><X size={24}/></button></div><label for="car-search-input">Model or brand</label><input id="car-search-input" type="search" placeholder="Try Toyota, Camry or BYD" autocomplete="off"/><p class="car-search-count" role="status">Enter a model or brand to search.</p><div class="car-search-results">{vehicles.map(v=><a href={vehicleHref(v)} data-search={`${v.name} ${v.brand} ${v.body} ${v.kind}`.toLowerCase()} hidden><span>{v.name}</span><small>{v.kind==='new'?'New model':'Used-car sourcing'}</small></a>)}</div><div class="car-search-directories"><a href="/new-cars/">All new cars</a><a href="/used-cars/">All used cars</a></div></dialog>
<script>
 const dialog=document.querySelector<HTMLDialogElement>('.car-search');const trigger=document.querySelector<HTMLButtonElement>('.car-search-trigger');const input=document.querySelector<HTMLInputElement>('#car-search-input');
 trigger?.addEventListener('click',()=>{dialog?.showModal();input?.focus()});document.querySelector('.car-search-close')?.addEventListener('click',()=>dialog?.close());dialog?.addEventListener('close',()=>trigger?.focus());
 dialog?.addEventListener('keydown',event=>{if(event.key==='Escape'){event.preventDefault();event.stopPropagation();dialog.close();}});
 input?.addEventListener('input',()=>{const term=input.value.trim().toLowerCase();let count=0;dialog?.querySelectorAll<HTMLElement>('[data-search]').forEach(link=>{const match=!!term&&!!link.dataset.search?.includes(term);link.hidden=!match;if(match)count++});const status=dialog?.querySelector('.car-search-count');if(status)status.textContent=term?`${count} matching ${count===1?'model':'models'}${count?'':'. Browse the directories or describe your requirement in an inquiry.'}`:'Enter a model or brand to search.'});
</script>
<style>
 .car-search-trigger,.car-search-close{display:grid;place-items:center;width:44px;height:44px;background:none;border:0;color:inherit;padding:0}.car-search{width:min(640px,calc(100% - 32px));max-height:85dvh;overflow:auto;border:1px solid #dde1df;border-radius:6px;padding:32px;background:#fff;color:#171a1b;box-shadow:0 24px 80px #0003}.car-search::backdrop{background:#10171999}.car-search-heading{display:flex;justify-content:space-between;gap:24px;align-items:center;margin-bottom:24px}.car-search-heading h2{font-size:32px;margin:0}.car-search label{display:block;font-size:16px;margin-bottom:8px}.car-search input{width:100%;min-height:52px;border:1px solid #aab1b1;border-radius:4px;padding:12px 14px;font-size:16px}.car-search-count{font-size:16px;margin:16px 0;color:#4b5053}.car-search-results a{display:flex;justify-content:space-between;gap:16px;padding:14px 0;border-bottom:1px solid #dde1df;align-items:center;font-size:18px}.car-search-results a[hidden]{display:none}.car-search-results small{font-size:14px;color:#60666a}.car-search-directories{display:flex;gap:24px;flex-wrap:wrap;margin-top:24px;font-size:16px;text-decoration:underline;text-underline-offset:4px}@media(max-width:700px){.car-search{padding:24px}.car-search-results a{display:block}.car-search-results small{display:block;margin-top:4px}}
</style>
