{
  "description": "Redirect www.keeyakauto.com to keeyakauto.com",
  "expression": "(http.host eq \"www.keeyakauto.com\")",
  "action": "redirect",
  "action_parameters": {
    "from_value": {
      "target_url": {
        "expression": "concat(\"https://keeyakauto.com\", http.request.uri.path)"
      },
      "status_code": 308,
      "preserve_query_string": true
    }
  },
  "enabled": true
}
